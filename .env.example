# Production API bootstrap. Copy values into the process environment; do not commit real secrets.
NODE_ENV=production
DATABASE_URL=postgres://molokh:replace-me@managed-postgres.example:5432/molokh
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
YOUTH_CONSENT_TOKEN_SECRET=replace-with-another-32-character-secret
PILOT_COMMUNITY_ID=00000000-0000-4000-8000-000000000001
PILOT_COMPETITION_ID=00000000-0000-4000-8000-000000000002
PUBLIC_WEB_URL=https://pilot.molokh.example
CORS_ALLOWED_ORIGINS=https://pilot.molokh.example
# Full lower-case Git SHA of the immutable API artifact.
RELEASE_SHA=0000000000000000000000000000000000000000
HOST=0.0.0.0
PORT=3000
