{
  "expo": {
    "name": "Molokh",
    "slug": "molokh",
    "scheme": "molokh",
    "version": "0.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "plugins": ["expo-router"],
    "android": {
      "package": "app.molokh.mobile",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "ios": {
      "bundleIdentifier": "app.molokh.mobile",
      "supportsTablet": true
    },
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}
